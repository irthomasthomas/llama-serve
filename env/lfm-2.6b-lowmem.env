# lfm-2.6b-lowmem — BeeLlama binary, port 8087. IQ4_XS + q3_0 KV + kv-tail-512, 128K ctx.
# 2.6 GB VRAM. Fits alongside lfm-8b with 2.2 GB to spare in 12 GB cards.
# Requires BeeLlama binary for --kv-tail-tokens support.
MODEL_FILE=/home/thomas/models/LFM2.5-2.6B-IQ4_XS/LiquidAI_LFM2.5-2.6B-IQ4_XS.gguf
PORT=8087
ARGS="-ngl 99 -c 131072 --host 0.0.0.0 -t 8 -tb 16 -cb -np 1 -fa on -ctk q3_0 -ctv q3_0 --kv-tail-tokens 512 --jinja --cache-reuse 256 --alias lfm2.5-2.6b-lowmem --temp 0.2 --top-k 80 --repeat-penalty 1.05"
BINARY=/home/thomas/bin/llama-server-beellama
