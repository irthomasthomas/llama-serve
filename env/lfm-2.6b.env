# lfm-2.6b — BeeLlama binary, port 8087. Q8_0 + q8_0 KV, 128K ctx.
# 4.6 GB VRAM. Co-locates with lfm-8b (7.2 GB) in 12 GB cards.
MODEL_FILE=/home/thomas/models/LFM2.5-2.6B-GGUF/LFM2.5-2.6B-Q8_0.gguf
PORT=8087
ARGS="-ngl 99 -c 131072 --host 0.0.0.0 -t 8 -tb 16 -cb -np 1 -fa on -ctk q8_0 -ctv q8_0 --jinja --cache-reuse 256 --alias lfm2.5-2.6b --temp 0.2 --top-k 80 --repeat-penalty 1.05"
